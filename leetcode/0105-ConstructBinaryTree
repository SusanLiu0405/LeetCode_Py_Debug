from typing import List, Optional

# Definition for a binary tree node.
class TreeNode:
    def __init__(self, val=0, left=None, right=None):
        self.val = val
        self.left = left
        self.right = right

class Solution:
    def buildTree(self, preorder: List[int], inorder: List[int]) -> Optional[TreeNode]:
        if not preorder or not inorder:
            return None

        # value -> index in inorder
        idx = {val: i for i, val in enumerate(inorder)}

        def build(preL: int, preR: int, inL: int, inR: int) -> Optional[TreeNode]:
            # build tree from:
            # preorder[preL:preR] and inorder[inL:inR]
            if preL >= preR or inL >= inR:
                return None

            root_val = preorder[preL]
            root = TreeNode(root_val)

            k = idx[root_val]             # root index in inorder
            left_size = k - inL

            root.left = build(preL + 1, preL + 1 + left_size, inL, k)
            root.right = build(preL + 1 + left_size, preR, k + 1, inR)
            return root

        return build(0, len(preorder), 0, len(inorder))

preorder = [3,9,20,15,7]
inorder = [9,3,15,20,7]
sol = Solution()
print(sol.buildTree(preorder, inorder))